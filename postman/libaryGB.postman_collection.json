            "url": {
              "raw": "{{base_url}}/api/staff-me"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
